#include <string>
#include <vector>

using namespace std;

vector<int> solution(vector<int> arr) {
    if(arr.size() <= 1){
        return{-1};
    }
    
    int min_index = 0;
    
    for(int i = 1; i < arr.size(); i++){
        if(arr[i] < arr[min_index]){
            min_index = i;
        }
    }
    
    arr.erase(arr.begin() + min_index);
        
    vector<int> answer = arr;

    return answer;
}
