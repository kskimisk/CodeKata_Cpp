#include <string>
#include <vector>

using namespace std;

int solution(string s) {

    vector<string> words = {
        "zero", "one", "two", "three", "four", 
        "five", "six", "seven", "eight", "nine"
    };
    
    for (int i = 0; i < 10; i++) {

        while (s.find(words[i]) != string::npos) {
            size_t pos = s.find(words[i]);
            

            s.replace(pos, words[i].length(), to_string(i));
        }
    }
    
    return stoi(s);
}
