#include <vector>
#include <algorithm>

using namespace std;

int solution(vector<vector<int>> sizes) {
    int max_w = 0;
    int max_h = 0;
    
    for(int i = 0; i < sizes.size(); i++) {
        int w = sizes[i][0];
        int h = sizes[i][1];
        
        int cur_max = max(w, h);
        int cur_min = min(w, h);
        
        max_w = max(max_w, cur_max);
        max_h = max(max_h, cur_min);
    }
    
    return max_w * max_h;
}
