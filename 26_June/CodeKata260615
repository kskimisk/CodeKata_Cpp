#include <string>
#include <vector>
#include <algorithm>

using namespace std;

vector<int> solution(int n, int m) {
    vector<int> answer;

    int gcd = 1;
    for (int i = 1; i <= min({n, m}); i++) {
        if (n % i == 0 && m % i == 0) {
            gcd = i;
        }
    }

    answer.push_back(gcd);


    int lcm = ((long long)n * m) / gcd;

    answer.push_back(lcm);

    return answer;
}
