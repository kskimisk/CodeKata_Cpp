#include <string>
#include <vector>

using namespace std;

vector<int> solution(int brown, int yellow) {
    vector<int> answer;
    int total_size = brown + yellow; // 1. 전체 카펫의 면적
    
    // 2. 세로(h)는 최소 3부터 시작 (위아래 테두리 2줄 + 가운데 노란색 1줄)
    for (int h = 3; h <= total_size / 3; h++) {
        
        // 3. 전체 면적이 세로로 나누어 떨어질 때만 진짜 사각형 모양이 됨
        if (total_size % h == 0) {
            int w = total_size / h; // 가로 길이 구하기
            
            // 4. (가로-2) * (세로-2) == 노란색 개수 인지 확인
            if ((w - 2) * (h - 2) == yellow) {
                // 문제 조건에서 가로가 세로보다 같거나 길다고 했으므로 w, h 순으로 넣음
                answer.push_back(w);
                answer.push_back(h);
                break; // 정답을 찾았으므로 반복문 즉시 종료
            }
        }
    }
    
    return answer;
}




/*풀이
1. 전체 크기 = Brown의 가로길이 * Brown의 세로길이 = brown + Yellow
2. 가로 + 세로 = (Brown / 2) + 2
    => 여기서 +1은 Brown의 가로와 세로 겹치는 부분.
3. Brown의 가로 = Yellow의 세로 +2 || Brown의 세로 = Yellow의 가로 + 2
4. 즉, 전체 크기 = (Yellow의 세로+2) * (Yellow의 가로 +2)
5. Brown = (Yellow의 세로+2) * (Yellow의 가로+2) - Yellow
    => Yellow의 크기 = Yellow의 가로 * Yellow의 세로
    => Y
6. 가로 + 세로 = (( Y의 세로 +2)*(Y의 가로+2)-Yellow)/2 +2
 */