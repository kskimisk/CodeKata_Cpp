#include <string>
#include <vector>

using namespace std;

long long solution(int n) {
    // n이 1이나 2일 때는 바로 정답을 리턴합니다.
    if (n == 1) return 1;
    if (n == 2) return 2;
    
    // DP (동적 계획법)을 위한 변수 초기화
    long long prev2 = 1; // n-2 칸까지 가는 방법
    long long prev1 = 2; // n-1 칸까지 가는 방법
    long long current = 0; // n 칸까지 가는 방법
    
    for (int i = 3; i <= n; i++) {
        // 경우의 수를 더할 때마다 1234567로 나눈 나머지를 저장합니다. (오버플로우 방지)
        current = (prev1 + prev2) % 1234567;
        
        // 다음 계산을 위해 변수들을 한 칸씩 앞으로 당깁니다.
        prev2 = prev1;
        prev1 = current;
    }
    
    return current;
}


/*
풀이방법
1. 첫 번째, 1칸(n=1)을 뛰는 방법은 (1)로 총 1가지뿐임.
2.   두 번째, 2칸(n=2)을 뛰는 방법은 (1, 1)과 (2)로 총 2가지임.
3.   세 번째, 3칸(n=3)을 뛰는 방법
   -> 2칸(n-1)까지 도달한 배열에서 마지막에 1칸을 더 뛰는 방법의 개수.
   -> 1칸(n-2)까지 도달한 배열에서 마지막에 2칸을 더 뛰는 방법의 개수.
   -> 즉, (1칸까지 가는 방법 수) + (2칸까지 가는 방법 수) = 3가지.
4.   그런 식의 공식을 세울 것.
   -> n번째 칸에 도달하는 방법 = (n-1번째 방법) + (n-2번째 방법)
5.   현재 칸의 방법 수를 더해서 구한 뒤, 숫자가 터지지 않게 1234567로 나눈 나머지를 임시 변수에 저장하고 다음 칸(앞으로 한 칸씩 이동)으로 넘어가기.
6.   목표한 숫자 n칸에 대한 계산 결과가 나오면 끝.
*/