#include <string>
#include <vector>
#include <sstream>
#include <algorithm> // min_element, max_element

using namespace std;

string solution(string s) {
    stringstream ss(s); 
    string token;
    vector<int> numbers;
    
    // 1단계: 문자열을 공백 기준으로 쪼개서 진짜 숫자(int)로 변환해 벡터에 담기 (파싱)
    while (ss >> token) {
        numbers.push_back(stoi(token)); // stoi가 '-' 부호까지 알아서 처리함
    }
    
    // 2단계: 벡터 안에서 최솟값, 최댓값 찾기
    // min_element/max_element는 주소(반복자)를 반환하므로 앞에 '*'을 붙여 값을 꺼냄
    int min_val = *min_element(numbers.begin(), numbers.end());
    int max_val = *max_element(numbers.begin(), numbers.end());
    
    // 3단계: 찾은 숫자를 다시 문자열(string)로 바꾸어 "최솟값 최댓값" 형태로 반환
    return to_string(min_val) + " " + to_string(max_val);
}



