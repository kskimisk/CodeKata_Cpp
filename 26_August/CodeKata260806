#include <string>
#include <vector>

using namespace std;

vector<int> solution(string s) {
    int transform_count = 0; // 이진 변환 횟수 누적
    int removed_zeros = 0;   // 제거된 0의 개수 누적

    // 4. 문자열 s가 "1"이 될 때까지 반복
    while (s != "1") {
        int current_zeros = 0;

        // 1. 진짜로 지우는 대신, 현재 문자열에서 '0'의 개수만 파악
        for (char c : s) {
            if (c == '0') {
                current_zeros++;
            }
        }

        // 찾아낸 0의 개수를 총합에 누적
        removed_zeros += current_zeros;

        // 2. 0을 제거한 후의 길이(c) 구하기
        int c = s.length() - current_zeros;

        // 3. 길이 c를 2진법 문자열로 변환하기
        string next_s = "";
        while (c > 0) {
            // 나머지를 문자열로 바꾸어 "앞"에다 붙여줍니다. 
            // (그래야 올바른 정방향 2진수가 됨)
            next_s = to_string(c % 2) + next_s; 
            c /= 2;
        }

        // 변환된 2진수 문자열을 다음 턴을 위해 s에 덮어씌움
        s = next_s;
        transform_count++; // 변환을 1회 완료했으므로 횟수 1 증가
    }

    // 5. [변환 횟수, 제거된 0의 개수] 형태로 반환
    return {transform_count, removed_zeros}; 
}


