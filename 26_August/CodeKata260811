#include <iostream>

using namespace std;

int solution(int n, int a, int b)
{
    int answer = 0;

       // A와 B의 번호가 같아지면 만난 것이므로, 같지 않을 때까지 계속 반복.
    while (a != b) 
    {
         // 다음 라운드의 숫자. 홀짝 구분 없이 /2 하면 다음 라운드에 쓸 숫자.
        a = (a + 1) / 2;
        b = (b + 1) / 2;
        
           // 6. 라운드가 진행될 때마다 정답 카운트 1 증가
        answer++;
    }

    return answer;
}



