#include <string>
#include <vector>
#include <cctype> // toupper, tolower를 사용하기 위한 헤더

using namespace std;

string solution(string s) {
    // 원본 문자열을 answer에 그대로 복사해두고 시작합니다.
    string answer = s;
    
    // 1. 첫 번째 문자는 앞글자가 없으므로 무조건 대문자 처리
    answer[0] = toupper(answer[0]);
    
    // 2. 두 번째 문자(인덱스 1)부터 끝까지 반복
    for (int i = 1; i < answer.length(); i++) {
        // 바로 앞 글자가 공백이었다면, 현재 글자는 단어의 시작이므로 대문자로
        if (answer[i - 1] == ' ') {
            answer[i] = toupper(answer[i]);
        } 
        // 앞 글자가 공백이 아니라면 단어의 중간이므로 소문자로
        else {
            answer[i] = tolower(answer[i]);
        }
    }
    
    return answer;
}

