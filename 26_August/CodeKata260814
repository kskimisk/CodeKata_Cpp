#include <string>
#include <vector>
#include <unordered_map>
#include <algorithm>

using namespace std;

int solution(int k, vector<int> tangerine) {
    int answer = 0;
    
    // 1. 귤의 크기별로 개수를 셈.
    unordered_map<int, int> countMap;
    for (int size : tangerine) {
        countMap[size]++;
    }
    
    // 2. 개수만 따로 모아서 벡터에 저장.
    vector<int> counts;
    for (auto pair : countMap) {
        counts.push_back(pair.second); // pair.second는 귤의 '개수'.
    }
    
    // 3. 개수가 많은 순서대로(내림차순) 정렬.
    // rbegin()과 rend()를 쓰면 쉽게 내림차순 정렬이 됨.
    sort(counts.rbegin(), counts.rend());
    
    // 4. 개수가 많은 귤부터 하나씩 상자에 담음.
    for (int count : counts) {
        k -= count;  // 상자에 귤을 담고, 담아야 할 남은 개수(k)를 줄임.
        answer++;    // 귤의 종류가 하나 추가되었으므로 1 증가
        
        if (k <= 0) { // 상자에 목표치 k개 이상을 담았다면 멈춤.
            break;
        }
    }
    
    return answer;
}


/* 풀이법
1. 귤의 크기별로 개수 세기
    - 크기가 최대 10,000,000까지 듬성듬성 있으므로, 일반 배열보다는 C++의 map이나 unordered_map을 사용해서 크기별 개수를 세어주는 것.
2. 개수만 따로 모아서 내림차순(큰 수부터) 정렬하기
    - 우리는 '어떤 크기'인지보다 '몇 개 들어있는지'가 중요. 개수만 vector에 따로 뽑아내어 가장 많은 것부터 정렬.
3. 가장 많은 것부터 상자에 담기 (k개 채우기)
    - 정렬된 개수를 순서대로 보면서, 내가 필요한 k개에서 빼나감.
    - 상자에 새로운 크기를 넣을 때마다 answer를 1씩 증가.
    - k가 0 이하가 되면 상자가 꽉 찬 것이므로 반복을 멈춤.
*/