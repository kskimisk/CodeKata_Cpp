#include <string>
#include <vector>
#include <unordered_map> // 맵을 사용하기 위해 반드시 추가!

using namespace std;

vector<string> solution(vector<string> players, vector<string> callings) {
    // 1. 선수들의 이름(string)과 현재 등수(int)를 저장할 사전 만들기
    unordered_map<string, int> player_rank;
    
    // 2. 초기 선수들의 등수(인덱스) 기록
    for(int i = 0; i < players.size(); i++){
        player_rank[players[i]] = i; 
    }
    
    // 3. 해설진이 이름을 부를 때마다 순위 바꾸기
    for(int i = 0; i < callings.size(); i++){
        string curr_player = callings[i];            // 불린 선수 (추월하는 선수)
        int curr_idx = player_rank[curr_player];     // 사전을 통해 현재 등수 즉시 확인
        string front_player = players[curr_idx - 1]; // 바로 앞 선수의 이름 확인
        
        // [vector 업데이트] 두 선수의 위치 맞바꾸기
        players[curr_idx - 1] = curr_player; 
        players[curr_idx] = front_player;    
        
        // [Map 업데이트] 사전의 등수 정보도 갱신
        player_rank[curr_player] = curr_idx - 1;
        player_rank[front_player] = curr_idx;
    }
    
    // 4. 모든 자리바꿈이 끝난 최종 배열 반환
    return players;
}