#include <string>
#include <vector>
#include <cassert>

using namespace std;

string solution(string phone_number) {
    string answer = "";
    assert(4<=phone_number.length() && phone_number.length()<=20); //문자 갯수니까 length 추가.
    int n = phone_number.length();
    for(int i = 0; i < n - 4; i++){
        phone_number[i] = '*';
    }
    answer = phone_number;
    return answer;
}
